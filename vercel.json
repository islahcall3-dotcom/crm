{
  "buildCommand": "cd frontend && npm install && npm run build",
  "installCommand": "echo 'Skipping root install'",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ]
}
